# ─── Vite / Frontend env vars (prefix with VITE_) ───────────────────────────

# GitHub OAuth App — create at github.com/settings/developers
VITE_GITHUB_CLIENT_ID=your_github_oauth_client_id_here

# Your GitHub username — ONLY this user can access /admin
VITE_ADMIN_GITHUB_USERNAME=soumya-ranjan-000

# The repo that stores CMS content (can be the same portfolio repo)
VITE_GITHUB_REPO_OWNER=soumya-ranjan-000
VITE_GITHUB_REPO_NAME=my-portfolio
VITE_GITHUB_REPO_BRANCH=main

# GitHub Personal Access Token (PAT) for CMS storage and auto-login (optional)
# Create a PAT with 'repo' scope on github.com/settings/tokens
# VITE_GITHUB_TOKEN=your_personal_access_token_here

# ─── Public Media CDN Settings (Optional) ───────────────────────────
# If set, media uploads will bypass local settings and default to these.
# VITE_CDN_OWNER=your_cdn_repo_owner_here
# VITE_CDN_REPO=your_cdn_repo_name_here
# VITE_CDN_BRANCH=main
# VITE_CDN_TOKEN=your_cdn_repo_write_token_here

# ─── Vercel-only env vars (NOT prefixed with VITE_ — never exposed to browser) ─
# Add these in Vercel Dashboard → Settings → Environment Variables
# GITHUB_CLIENT_ID=your_github_oauth_client_id_here
# GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
